                      <Option type="QString" name="expression" value="CASE&#10;  WHEN &quot;railway&quot; = 'light_rail' THEN '#888888'&#10;  WHEN coalesce(&quot;service&quot;, '') IN ('yard', 'siding', 'spur', 'crossover') THEN '#b0b0b0'&#10;  ELSE '#787878'&#10;END"/>
                      
                  
