          </Option>
          
    
        </data-defined-properties>
        
    
        <orderby>
          
      
          <orderByClause nullsFirst="0" asc="1">CASE
  WHEN "railway" = 'rail' AND coalesce("service", '') NOT IN ('yard', 'siding', 'spur', 'crossover') THEN 4
  WHEN "railway" = 'light_rail' THEN 3
  WHEN "railway" = 'rail' THEN 2
  ELSE 1
END</orderByClause>
          
    
