          <proj4>+proj=eqc +lat_ts=0 +lat_0=0 +lon_0=0 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs</proj4>
          <srsid>60036</srsid>
          <srid>520000036</srid>
          <authid>EPSG:4087</authid>
          <description>WGS 84 / World Equidistant Cylindrical</description>
